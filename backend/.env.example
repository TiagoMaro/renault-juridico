# Copie para .env e ajuste conforme o ambiente.

# --- Banco de dados (PostgreSQL) ---
# Rodando com docker-compose, o host é "db"; localmente, "localhost".
DATABASE_URL=postgresql+psycopg2://juridico:juridico@localhost:5432/juridico

# --- Segurança ---
# Gere uma chave nova para produção:  openssl rand -hex 32
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS: endereços do front que podem chamar a API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Regras de negócio: faixas de risco (R$) ---
RISCO_CRITICO_MIN=1000000
RISCO_ALTO_MIN=300000
RISCO_MEDIO_MIN=50000
RISCO_AGRAVA_SEM_DEFESA=true

# --- Importação ---
MAX_UPLOAD_MB=25
DIAS_SEM_MOVIMENTACAO_ALERTA=90
